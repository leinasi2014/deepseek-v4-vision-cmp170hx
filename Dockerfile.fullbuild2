# Shared-deps variant of allover Dockerfile.fullbuild: dependency layers first,
# per-tree COPY last, so builds B/C reuse this cache. Same final image content.
FROM nvidia/cuda:13.0.2-cudnn-devel-ubuntu24.04

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
        python3.12 python3.12-dev python3.12-venv git build-essential curl \
        ca-certificates ccache cmake ninja-build \
    && rm -rf /var/lib/apt/lists/*
RUN python3.12 -m venv /opt/venv
ENV PATH=/opt/venv/bin:/usr/local/cuda/bin:/usr/lib/ccache:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ENV CUDA_HOME=/usr/local/cuda
RUN pip install --no-cache-dir -U pip "setuptools>=77.0.3,<81.0.0" wheel \
        "setuptools-scm>=8.0" "setuptools-rust>=1.9.0" ninja "cmake>=3.26.1" \
        "packaging>=24.2" jinja2
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
      | sh -s -- -y --default-toolchain 1.95 --profile minimal
ENV PATH=/root/.cargo/bin:$PATH
RUN pip install --no-cache-dir torch==2.13.0 torchaudio==2.11.0 torchvision==0.28.0
ENV SETUPTOOLS_SCM_PRETEND_VERSION=0.0.0
ENV TORCH_CUDA_ARCH_LIST=8.0
ENV MAX_JOBS=48
ENV CMAKE_BUILD_TYPE=Release
ENV VLLM_TARGET_DEVICE=cuda
COPY dsv4-srcs /opt/dsv4-srcs
ENV VLLM_CUTLASS_SRC_DIR=/opt/dsv4-srcs/cutlass
ENV TRITON_KERNELS_SRC_DIR=/opt/dsv4-srcs/triton/python/triton_kernels
WORKDIR /vllm
COPY . /vllm/
RUN rustc --version && pip install --no-cache-dir -e . --no-build-isolation
RUN nvcc --version | tail -2 && python3 -c "import vllm, torch; print('vllm', vllm.__version__, 'torch', torch.__version__)" && ls -la /vllm/vllm/*.so && python3 -c "import torch, vllm; import vllm._custom_ops as o; print('custom ops import OK')"
